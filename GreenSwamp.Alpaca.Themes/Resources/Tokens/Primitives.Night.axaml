<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Night.Neutral.000">#FF120404</Color>
  <Color x:Key="Color.Night.Neutral.050">#FF0E0303</Color>
  <Color x:Key="Color.Night.Neutral.100">#FF0A0202</Color>
  <Color x:Key="Color.Night.Neutral.200">#FF170606</Color>
  <Color x:Key="Color.Night.Neutral.300">#FF240909</Color>
  <Color x:Key="Color.Night.Neutral.500">#FF7C2A2A</Color>
  <Color x:Key="Color.Night.Neutral.700">#FFB03B3B</Color>
  <Color x:Key="Color.Night.Neutral.900">#FFFF6B6B</Color>
  <Color x:Key="Color.Night.Accent.Primary">#FFFF4D4D</Color>
  <Color x:Key="Color.Night.Accent.PrimaryHover">#FFFF5D5D</Color>
  <Color x:Key="Color.Night.Accent.PrimaryPressed">#FFE64545</Color>
  <Color x:Key="Color.Night.Accent.Subtle">#26FF4D4D</Color>
  <Color x:Key="Color.Night.Focus">#FFFF6B6B</Color>
  <Color x:Key="Color.Night.Selection">#33FF4D4D</Color>
  <Color x:Key="Color.Night.Success">#FFFF4D4D</Color>
  <Color x:Key="Color.Night.Warning">#FFFF7A4D</Color>
  <Color x:Key="Color.Night.Error">#FFFF4D4D</Color>
  <Color x:Key="Color.Night.Info">#FFFF6B6B</Color>
</ResourceDictionary>
